# Public canonical URL used for metadata, sitemap and robots (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://somabay.com

# Server-only. Endpoint that receives newsletter signups as JSON: { "email": "...", "source": "somabay.com" }.
# Leave empty to keep the footer form in "temporarily unavailable" mode.
NEWSLETTER_WEBHOOK_URL=

# Server-only. Endpoint that receives contact, booking and call-request forms as JSON:
# { "form": "contact|spa|tee|unit", "subject": "...", "context": "...", "values": { ... } }.
ENQUIRY_WEBHOOK_URL=
